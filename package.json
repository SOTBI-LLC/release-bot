{
	"name": "telegram-bots",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"bot:create": "node scripts/create-bot.mjs",
		"dev": "yarn workspace @bots/releasebot dev",
		"start": "yarn dev",
		"deploy": "yarn workspace @bots/releasebot deploy",
		"test": "vitest",
		"test:run": "vitest run",
		"typecheck": "yarn workspaces run typecheck",
		"cf-typegen": "yarn workspace @bots/releasebot cf-typegen",
		"deploy:check": "node scripts/check-deployments.mjs"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.16.18",
		"@types/node": "^26.0.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.9",
		"wrangler": "^4.103.0"
	},
	"packageManager": "yarn@1.22.22",
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
